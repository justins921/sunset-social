# Copy to .env.local for local development, or set these in Vercel → Settings → Environment Variables.

# Postgres connection string.
# In Vercel, adding a Postgres store injects POSTGRES_URL automatically — you do
# not need to set this by hand there. For local dev, point it at any Postgres:
#   POSTGRES_URL="postgres://user:pass@host:5432/dbname"
# (DATABASE_URL is also accepted.)
POSTGRES_URL=

# Password that unlocks the /admin score-entry area. Choose something only the
# secretary knows. If unset, the admin area shows setup instructions and stays
# locked (the public site still works).
ADMIN_PASSWORD=

# Optional: a separate secret used to sign the admin session cookie. If omitted,
# one is derived from ADMIN_PASSWORD. Set this if you want sessions to survive a
# password change.
# ADMIN_SESSION_SECRET=
